{
  "name": "FamilyMessage",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID \u0441\u0435\u043c\u044c\u0438, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043e\u0442\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435"
    },
    "content": {
      "type": "string",
      "description": "\u0422\u0435\u043a\u0441\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f"
    },
    "type": {
      "type": "string",
      "enum": [
        "text",
        "money_request"
      ],
      "default": "text",
      "description": "\u041e\u0431\u044b\u0447\u043d\u043e\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u0437\u0430\u043f\u0440\u043e\u0441 \u0434\u0435\u043d\u0435\u0433 \u0443 \u0447\u043b\u0435\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438"
    },
    "amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u0437\u0430\u043f\u0440\u043e\u0441\u0430 (\u0434\u043b\u044f type=money_request)"
    },
    "request_status": {
      "type": "string",
      "enum": [
        "pending",
        "fulfilled"
      ],
      "default": "pending",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u0430 \u0434\u0435\u043d\u0435\u0433"
    },
    "paid_by": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u0442\u043c\u0435\u0442\u0438\u043b \u0437\u0430\u043f\u0440\u043e\u0441 \u043e\u043f\u043b\u0430\u0447\u0435\u043d\u043d\u044b\u043c \u0438 \u0441\u043e\u0432\u0435\u0440\u0448\u0438\u043b \u043f\u0435\u0440\u0435\u0432\u043e\u0434"
    },
    "transaction_id": {
      "type": "string",
      "description": "ID \u0441\u043e\u0437\u0434\u0430\u043d\u043d\u043e\u0439 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 \u043f\u043e \u044d\u0442\u043e\u043c\u0443 \u0437\u0430\u043f\u0440\u043e\u0441\u0443 \u0434\u0435\u043d\u0435\u0433"
    },
    "edited": {
      "type": "boolean",
      "default": false,
      "description": "\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0431\u044b\u043b\u043e \u043e\u0442\u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043e"
    },
    "reactions": {
      "type": "array",
      "default": [],
      "description": "\u042d\u043c\u043e\u0434\u0437\u0438-\u0440\u0435\u0430\u043a\u0446\u0438\u0438 \u043d\u0430 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "user_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "read_by": {
      "type": "array",
      "default": [],
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439, \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432\u0448\u0438\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "family_id",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}