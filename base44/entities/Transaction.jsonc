{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense",
        "transfer"
      ],
      "description": "\u0422\u0438\u043f \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438"
    },
    "amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438"
    },
    "currency": {
      "type": "string",
      "default": "RUB",
      "description": "\u0412\u0430\u043b\u044e\u0442\u0430"
    },
    "category": {
      "type": "string",
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438"
    },
    "subcategory": {
      "type": "string",
      "description": "\u041f\u043e\u0434\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "\u0414\u0430\u0442\u0430 \u0438 \u0432\u0440\u0435\u043c\u044f \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438"
    },
    "account_id": {
      "type": "string",
      "description": "ID \u0441\u0447\u0451\u0442\u0430"
    },
    "to_account_id": {
      "type": "string",
      "description": "ID \u0441\u0447\u0451\u0442\u0430-\u043f\u043e\u043b\u0443\u0447\u0430\u0442\u0435\u043b\u044f (\u0434\u043b\u044f \u0442\u0438\u043f\u0430 transfer)"
    },
    "family_member_id": {
      "type": "string",
      "description": "ID \u0447\u043b\u0435\u043d\u0430 \u0441\u0435\u043c\u044c\u0438"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0422\u0435\u0433\u0438"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "\u0420\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u0430\u044f \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044f"
    },
    "recurring_period": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "yearly"
      ],
      "description": "\u041f\u0435\u0440\u0438\u043e\u0434 \u043f\u043e\u0432\u0442\u043e\u0440\u0435\u043d\u0438\u044f"
    },
    "attachment_url": {
      "type": "string",
      "description": "\u041f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u044b\u0439 \u0444\u0430\u0439\u043b (\u0447\u0435\u043a)"
    },
    "source": {
      "type": "string",
      "enum": [
        "app",
        "telegram_bot"
      ],
      "default": "app",
      "description": "\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438"
    },
    "family_id": {
      "type": "string",
      "description": "ID \u0441\u0435\u043c\u044c\u0438"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u0441\u043e\u0437\u0434\u0430\u0432\u0448\u0435\u0433\u043e \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044e"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (Workspace-\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "\u0412\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u044c: \u043b\u0438\u0447\u043d\u0430\u044f \u0438\u043b\u0438 \u043e\u0431\u0449\u0430\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430"
    },
    "budget_scope": {
      "type": "string",
      "enum": [
        "personal",
        "family"
      ],
      "description": "\u0415\u0441\u043b\u0438 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0438 \u0441 \u043b\u0438\u0447\u043d\u044b\u043c, \u0438 \u0441 \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c \u0431\u044e\u0434\u0436\u0435\u0442\u043e\u043c \u2014 \u0432 \u043a\u0430\u043a\u043e\u0439 \u0438\u043c\u0435\u043d\u043d\u043e \u0431\u044e\u0434\u0436\u0435\u0442 \u0437\u0430\u0441\u0447\u0438\u0442\u0430\u0442\u044c \u044d\u0442\u043e\u0442 \u0440\u0430\u0441\u0445\u043e\u0434"
    }
  },
  "required": [
    "type",
    "amount",
    "category",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}