{
  "name": "ChildExpense",
  "type": "object",
  "properties": {
    "child_name": {
      "type": "string",
      "description": "\u0418\u043c\u044f \u0440\u0435\u0431\u0451\u043d\u043a\u0430"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "education",
        "health",
        "clothes",
        "entertainment",
        "other"
      ],
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0440\u0430\u0441\u0445\u043e\u0434\u043e\u0432"
    },
    "amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "\u0414\u0430\u0442\u0430 \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "description": {
      "type": "string",
      "description": "\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435"
    },
    "family_id": {
      "type": "string",
      "description": "ID \u0441\u0435\u043c\u044c\u0438"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u0441\u043e\u0437\u0434\u0430\u0432\u0448\u0435\u0433\u043e \u0440\u0430\u0441\u0445\u043e\u0434"
    }
  },
  "required": [
    "child_name",
    "category",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": "{{user.family_id}}"
            },
            {
              "user.family_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": "{{user.family_id}}"
            },
            {
              "user.family_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}