{
  "name": "CourseCertificate",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "course_title": {
      "type": "string"
    },
    "certificate_number": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "course_id",
    "user_id",
    "student_name",
    "course_title",
    "certificate_number",
    "issued_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}