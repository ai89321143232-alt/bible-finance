{
  "name": "FinancialScenario",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "debt_payoff",
        "emergency_fund",
        "large_purchase",
        "income_change",
        "other"
      ]
    },
    "monthly_amount": {
      "type": "number"
    },
    "months": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "projection_text": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "family"
      ],
      "default": "personal"
    },
    "family_id": {
      "type": "string"
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "is_selected": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "kind",
    "monthly_amount",
    "months"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participant_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participant_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}