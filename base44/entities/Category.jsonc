{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "\u0422\u0438\u043f \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438"
    },
    "icon": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0438\u043a\u043e\u043d\u043a\u0438"
    },
    "color": {
      "type": "string",
      "description": "\u0426\u0432\u0435\u0442 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438"
    },
    "parent_id": {
      "type": "string",
      "description": "ID \u0440\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u0441\u043a\u043e\u0439 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438"
    },
    "is_system": {
      "type": "boolean",
      "default": false,
      "description": "\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0430\u044f \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f"
    },
    "budget_default": {
      "type": "number",
      "description": "\u0420\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u044b\u0439 \u0431\u044e\u0434\u0436\u0435\u0442 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e"
    }
  },
  "required": [
    "name",
    "type",
    "icon",
    "color"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.is_system": true
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.is_system": true
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.is_system": false
        }
      ]
    }
  }
}