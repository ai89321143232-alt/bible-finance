{
  "name": "Budget",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0431\u044e\u0434\u0436\u0435\u0442\u0430"
    },
    "category": {
      "type": "string",
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0440\u0430\u0441\u0445\u043e\u0434\u043e\u0432 (\u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0435\u0435, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 categories)"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0421\u043f\u0438\u0441\u043e\u043a \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0439 \u0440\u0430\u0441\u0445\u043e\u0434\u043e\u0432 \u0434\u043b\u044f \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u044f"
    },
    "limit_amount": {
      "type": "number",
      "description": "\u041b\u0438\u043c\u0438\u0442 \u0431\u044e\u0434\u0436\u0435\u0442\u0430"
    },
    "spent_amount": {
      "type": "number",
      "default": 0,
      "description": "\u041f\u043e\u0442\u0440\u0430\u0447\u0435\u043d\u043e"
    },
    "period": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "yearly"
      ],
      "default": "monthly"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "color": {
      "type": "string"
    },
    "notify_at_percent": {
      "type": "number",
      "default": 80,
      "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u0438\u0442\u044c \u043f\u0440\u0438 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0438 % \u043e\u0442 \u043b\u0438\u043c\u0438\u0442\u0430"
    },
    "family_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "is_family_budget": {
      "type": "boolean",
      "default": false,
      "description": "\u042f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043b\u0438 \u044d\u0442\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u044b\u043c \u0431\u044e\u0434\u0436\u0435\u0442\u043e\u043c"
    },
    "share_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u0435\u043c\u044c\u0438, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043f\u043e\u0434\u0435\u043b\u0435\u043d \u0431\u044e\u0434\u0436\u0435\u0442"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u0443\u0436\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u0432 \u044d\u0442\u043e\u043c \u043f\u0435\u0440\u0438\u043e\u0434\u0435"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved",
      "description": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u044f \u0431\u044e\u0434\u0436\u0435\u0442\u0430 \u0434\u0440\u0443\u0433\u0438\u043c \u0447\u043b\u0435\u043d\u043e\u043c \u0441\u0435\u043c\u044c\u0438"
    },
    "pending_approval_from": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u043e\u0442 \u043a\u043e\u0442\u043e\u0440\u043e\u0433\u043e \u043e\u0436\u0438\u0434\u0430\u0435\u0442\u0441\u044f \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435"
    }
  },
  "required": [
    "name",
    "limit_amount",
    "period"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.share_with": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "user"
      }
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.share_with": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}