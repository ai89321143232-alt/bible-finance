{
  "name": "Goal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0446\u0435\u043b\u0438"
    },
    "type": {
      "type": "string",
      "enum": [
        "savings",
        "debt_payoff",
        "investment",
        "purchase",
        "emergency_fund",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u0446\u0435\u043b\u0438"
    },
    "target_amount": {
      "type": "number",
      "description": "\u0426\u0435\u043b\u0435\u0432\u0430\u044f \u0441\u0443\u043c\u043c\u0430"
    },
    "current_amount": {
      "type": "number",
      "default": 0,
      "description": "\u041d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043e"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "\u0414\u0435\u0434\u043b\u0430\u0439\u043d"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "color": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "auto_contribute": {
      "type": "boolean",
      "default": false
    },
    "monthly_contribution": {
      "type": "number",
      "description": "\u0415\u0436\u0435\u043c\u0435\u0441\u044f\u0447\u043d\u044b\u0439 \u0432\u0437\u043d\u043e\u0441"
    },
    "family_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f-\u0441\u043e\u0437\u0434\u0430\u0442\u0435\u043b\u044f"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (Workspace-\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "\u0412\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u044c: \u043b\u0438\u0447\u043d\u0430\u044f \u0438\u043b\u0438 \u043e\u0431\u0449\u0430\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    },
    "is_family_goal": {
      "type": "boolean",
      "default": false,
      "description": "\u042f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043b\u0438 \u044d\u0442\u043e \u0441\u0435\u043c\u0435\u0439\u043d\u043e\u0439 \u0446\u0435\u043b\u044c\u044e"
    },
    "share_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439 \u0441\u0435\u043c\u044c\u0438, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c\u0438 \u043f\u043e\u0434\u0435\u043b\u0435\u043d\u0430 \u0446\u0435\u043b\u044c"
    },
    "subgoals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "target_amount": {
            "type": "number"
          },
          "current_amount": {
            "type": "number",
            "default": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed",
              "paused"
            ],
            "default": "active"
          }
        }
      },
      "default": []
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "default": [],
      "description": "\u0412\u043a\u043b\u0430\u0434\u044b \u0447\u043b\u0435\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438 \u0432 \u0446\u0435\u043b\u044c"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "\u0423\u0432\u0435\u0434\u043e\u043c\u043b\u0435\u043d\u0438\u0435 \u043e \u043f\u0440\u0438\u0431\u043b\u0438\u0436\u0435\u043d\u0438\u0438 \u0434\u0435\u0434\u043b\u0430\u0439\u043d\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e"
    },
    "linked_account_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ID \u0441\u0447\u0451\u0442\u043e\u0432, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u043d\u0430\u043a\u043e\u043f\u043b\u0435\u043d\u043d\u044b\u0435 \u043d\u0430 \u0446\u0435\u043b\u044c \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430"
    },
    "linked_investment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ID \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0439 \u0438 \u0432\u043a\u043b\u0430\u0434\u043e\u0432, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043e\u0442\u043d\u043e\u0441\u044f\u0442\u0441\u044f \u043a \u044d\u0442\u043e\u0439 \u0446\u0435\u043b\u0438"
    }
  },
  "required": [
    "title",
    "type",
    "target_amount"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        },
        {
          "data.share_with": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        },
        {
          "data.share_with": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}