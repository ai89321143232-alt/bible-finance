{
  "name": "TelegramBotConfig",
  "type": "object",
  "properties": {
    "bot_token": {
      "type": "string",
      "description": "\u0422\u043e\u043a\u0435\u043d Telegram-\u0431\u043e\u0442\u0430, \u0432\u044b\u0434\u0430\u043d\u043d\u044b\u0439 @BotFather"
    },
    "bot_username": {
      "type": "string",
      "description": "Username \u0431\u043e\u0442\u0430 (\u0431\u0435\u0437 @)"
    },
    "telegram_user_id": {
      "type": "string",
      "description": "Telegram ID \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0431\u043e\u0442\u0430"
    },
    "linked_members": {
      "type": "array",
      "default": [],
      "description": "\u0427\u043b\u0435\u043d\u044b \u0441\u0435\u043c\u044c\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c\u0441\u044f \u0431\u043e\u0442\u043e\u043c",
      "items": {
        "type": "object",
        "properties": {
          "telegram_user_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "linked_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "pending_links": {
      "type": "array",
      "default": [],
      "description": "\u0417\u0430\u043f\u0440\u043e\u0441\u044b \u0447\u043b\u0435\u043d\u043e\u0432 \u0441\u0435\u043c\u044c\u0438 \u043d\u0430 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0431\u043e\u0442\u0443",
      "items": {
        "type": "object",
        "properties": {
          "telegram_user_id": {
            "type": "string"
          },
          "telegram_display_name": {
            "type": "string"
          },
          "requested_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "default_account_id": {
      "type": "string",
      "description": "\u0421\u0447\u0451\u0442 \u0434\u043b\u044f \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u0438\u0437 Telegram"
    },
    "timezone": {
      "type": "string",
      "default": "Europe/Moscow",
      "description": "\u0427\u0430\u0441\u043e\u0432\u043e\u0439 \u043f\u043e\u044f\u0441 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f (IANA)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0411\u043e\u0442 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d \u0438 \u0430\u043a\u0442\u0438\u0432\u0435\u043d"
    },
    "last_error": {
      "type": "string",
      "description": "\u041f\u043e\u0441\u043b\u0435\u0434\u043d\u044f\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f/webhook"
    },
    "webhook_secret": {
      "type": "string",
      "description": "\u0421\u0435\u043a\u0440\u0435\u0442\u043d\u044b\u0439 \u0442\u043e\u043a\u0435\u043d webhook Telegram"
    },
    "chat_history": {
      "type": "array",
      "default": [],
      "description": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u043a\u0438 \u0441 AI-\u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u043e\u043c",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "pending_transactions": {
      "type": "array",
      "default": [],
      "description": "\u041e\u043f\u0435\u0440\u0430\u0446\u0438\u0438, \u043e\u0436\u0438\u0434\u0430\u044e\u0449\u0438\u0435 \u0432\u044b\u0431\u043e\u0440\u0430 \u0441\u0447\u0451\u0442\u0430",
      "items": {
        "type": "object",
        "properties": {
          "telegram_user_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "income",
              "expense"
            ]
          },
          "amount": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "bot_token",
    "telegram_user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}