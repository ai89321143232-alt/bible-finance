{
  "name": "LessonProgress",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "quiz_answers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "index": {
            "type": "number"
          }
        }
      }
    },
    "quiz_passed": {
      "type": "boolean",
      "default": false
    },
    "practice_answer": {
      "type": "string"
    },
    "practice_completed": {
      "type": "boolean",
      "default": false
    },
    "practice_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "course_id",
    "lesson_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}