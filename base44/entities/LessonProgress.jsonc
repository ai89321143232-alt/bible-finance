{
  "name": "LessonProgress",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "quiz_answers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "index": {
            "type": "number"
          }
        }
      }
    },
    "quiz_passed": {
      "type": "boolean",
      "default": false
    },
    "practice_answer": {
      "type": "string"
    },
    "practice_completed": {
      "type": "boolean",
      "default": false
    },
    "practice_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "day_practice_done": {
      "type": "array",
      "default": [],
      "description": "\u041e\u0442\u043c\u0435\u0442\u043a\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u043d\u0438\u0439 \u043f\u043e \u0434\u043d\u044f\u043c \u0443\u0440\u043e\u043a\u0430",
      "items": {
        "type": "object",
        "properties": {
          "day_index": {
            "type": "number"
          },
          "done": {
            "type": "boolean"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "course_id",
    "lesson_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}