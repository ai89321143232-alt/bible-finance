{
  "name": "ChildGameProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f"
    },
    "total_coins": {
      "type": "number",
      "default": 0,
      "description": "\u041e\u0431\u0449\u0435\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043c\u043e\u043d\u0435\u0442\u043e\u043a"
    },
    "last_daily_login": {
      "type": "string",
      "format": "date",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0433\u043e \u0435\u0436\u0435\u0434\u043d\u0435\u0432\u043d\u043e\u0433\u043e \u043d\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043d\u0438\u044f"
    },
    "daily_transactions_count": {
      "type": "number",
      "default": 0,
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0439 \u0441\u0435\u0433\u043e\u0434\u043d\u044f"
    },
    "last_transaction_date": {
      "type": "string",
      "format": "date",
      "description": "\u0414\u0430\u0442\u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u0439 \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u0438 \u0434\u043b\u044f \u0441\u0431\u0440\u043e\u0441\u0430 \u0441\u0447\u0451\u0442\u0447\u0438\u043a\u0430"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0438\u0433\u0440\u043e\u043a\u0430"
    },
    "streak_days": {
      "type": "number",
      "default": 0,
      "description": "\u0421\u0435\u0440\u0438\u044f \u0434\u043d\u0435\u0439 \u043f\u043e\u0434\u0440\u044f\u0434"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u043d\u044b\u0435 \u0434\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u044f"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}