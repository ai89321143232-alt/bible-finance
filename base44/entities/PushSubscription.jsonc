{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u043c\u0443 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430"
    },
    "endpoint": {
      "type": "string",
      "description": "URL \u044d\u043d\u0434\u043f\u043e\u0438\u043d\u0442\u0430 push-\u0441\u0435\u0440\u0432\u0438\u0441\u0430 (FCM/APNS)"
    },
    "keys_p256dh": {
      "type": "string",
      "description": "P-256dh \u043f\u0443\u0431\u043b\u0438\u0447\u043d\u044b\u0439 \u043a\u043b\u044e\u0447 \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (base64url)"
    },
    "keys_auth": {
      "type": "string",
      "description": "Auth secret \u043a\u043b\u0438\u0435\u043d\u0442\u0430 (base64url)"
    },
    "user_agent": {
      "type": "string",
      "description": "User-Agent \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0430 \u0434\u043b\u044f \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "desktop",
        "other"
      ],
      "default": "other",
      "description": "\u041f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u0410\u043a\u0442\u0438\u0432\u043d\u0430 \u043b\u0438 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0430"
    }
  },
  "required": [
    "user_id",
    "endpoint",
    "keys_p256dh",
    "keys_auth"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}