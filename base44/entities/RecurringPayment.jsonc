{
  "name": "RecurringPayment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0438 \u0438\u043b\u0438 \u0440\u0435\u0433\u0443\u043b\u044f\u0440\u043d\u043e\u0433\u043e \u043f\u043b\u0430\u0442\u0435\u0436\u0430"
    },
    "amount": {
      "type": "number",
      "description": "\u0421\u0443\u043c\u043c\u0430 \u043f\u043b\u0430\u0442\u0435\u0436\u0430"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "period": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly",
        "quarterly",
        "yearly"
      ],
      "default": "monthly",
      "description": "\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "billing_day": {
      "type": "number",
      "description": "\u0414\u0435\u043d\u044c \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f (1-31)"
    },
    "next_charge_date": {
      "type": "string",
      "format": "date",
      "description": "\u0414\u0430\u0442\u0430 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "category": {
      "type": "string",
      "description": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u044f \u0440\u0430\u0441\u0445\u043e\u0434\u0430"
    },
    "account_id": {
      "type": "string",
      "description": "ID \u0441\u0447\u0451\u0442\u0430 \u0434\u043b\u044f \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u041f\u043e\u0434\u043f\u0438\u0441\u043a\u0430 \u0430\u043a\u0442\u0438\u0432\u043d\u0430"
    },
    "auto_create_transaction": {
      "type": "boolean",
      "default": false,
      "description": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0437\u0434\u0430\u0432\u0430\u0442\u044c \u0442\u0440\u0430\u043d\u0437\u0430\u043a\u0446\u0438\u044e \u0432 \u0434\u0435\u043d\u044c \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044f"
    },
    "reminder_days_before": {
      "type": "number",
      "default": 3,
      "description": "\u0417\u0430 \u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0434\u043d\u0435\u0439 \u043d\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u043e \u0441\u043f\u0438\u0441\u0430\u043d\u0438\u0438"
    },
    "icon": {
      "type": "string",
      "description": "\u0418\u043a\u043e\u043d\u043a\u0430 (lucide-react name)"
    },
    "color": {
      "type": "string"
    },
    "notes": {
      "type": "string",
      "description": "\u0417\u0430\u043c\u0435\u0442\u043a\u0438 (\u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043e\u0442\u043c\u0435\u043d\u044b, \u043a\u043e\u043c\u0438\u0441\u0441\u0438\u0438 \u0438 \u0442.\u0434.)"
    },
    "cancelled": {
      "type": "boolean",
      "default": false,
      "description": "\u041f\u043e\u0434\u043f\u0438\u0441\u043a\u0430 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u0430"
    },
    "family_id": {
      "type": "string",
      "description": "ID \u0441\u0435\u043c\u044c\u0438"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f-\u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "\u0412\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u044c: \u043b\u0438\u0447\u043d\u0430\u044f \u0438\u043b\u0438 \u043e\u0431\u0449\u0430\u044f"
    }
  },
  "required": [
    "name",
    "amount",
    "period",
    "billing_day"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}