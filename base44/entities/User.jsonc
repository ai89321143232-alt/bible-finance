{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "family_id": {
      "type": "string",
      "description": "ID \u0441\u0435\u043c\u044c\u0438, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0438\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c"
    },
    "theme": {
      "type": "string",
      "enum": [
        "adult",
        "child"
      ],
      "default": "adult",
      "description": "\u0422\u0435\u043c\u0430 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430"
    },
    "subscription": {
      "type": "string",
      "enum": [
        "free",
        "premium",
        "family"
      ],
      "default": "free"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false,
      "description": "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u043b \u043b\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043e\u043d\u0431\u043e\u0440\u0434\u0438\u043d\u0433"
    }
  }
}