{
  "name": "LearningLesson",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "resource_url": {
      "type": "string"
    },
    "lesson_file_uri": {
      "type": "string"
    },
    "assignment_file_uri": {
      "type": "string"
    },
    "practice_prompt": {
      "type": "string"
    },
    "quiz_questions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "text"
            ],
            "default": "single"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": "number"
          },
          "correct_indexes": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "correct_text": {
            "type": "string"
          }
        }
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "course_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    }
  },
  "required": [
    "course_id",
    "module_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.course_status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}