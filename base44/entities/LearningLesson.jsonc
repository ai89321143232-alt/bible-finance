{
  "name": "LearningLesson",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string"
    },
    "module_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "resource_url": {
      "type": "string"
    },
    "lesson_file_uri": {
      "type": "string"
    },
    "assignment_file_uri": {
      "type": "string"
    },
    "practice_prompt": {
      "type": "string"
    },
    "quiz_questions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "text"
            ],
            "default": "single"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "correct_index": {
            "type": "number"
          },
          "correct_indexes": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "correct_text": {
            "type": "string"
          }
        }
      }
    },
    "days": {
      "type": "array",
      "default": [],
      "description": "\u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u043a\u0443\u0440\u0441\u0430 \u043f\u043e \u0434\u043d\u044f\u043c: \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b, \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0434\u043d\u044f (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \"\u0414\u0435\u043d\u044c \u043f\u0435\u0440\u0432\u044b\u0439\")"
          },
          "scripture": {
            "type": "string",
            "description": "\u0411\u0438\u0431\u043b\u0435\u0439\u0441\u043a\u0438\u0439 \u0441\u0442\u0438\u0445 \u0434\u043b\u044f \u0437\u0430\u0443\u0447\u0438\u0432\u0430\u043d\u0438\u044f"
          },
          "scripture_ref": {
            "type": "string",
            "description": "\u0421\u0441\u044b\u043b\u043a\u0430 \u043d\u0430 \u043e\u0442\u0440\u044b\u0432\u043e\u043a (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \"\u041b\u0443\u043a\u0438 16:11\")"
          },
          "reading": {
            "type": "string",
            "description": "\u0423\u043a\u0430\u0437\u0430\u043d\u0438\u0435, \u0447\u0442\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c"
          },
          "content": {
            "type": "string",
            "description": "\u0423\u0447\u0435\u0431\u043d\u044b\u0439 \u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u0434\u043d\u044f"
          },
          "questions": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "\u0422\u0435\u043a\u0441\u0442 \u0432\u043e\u043f\u0440\u043e\u0441\u0430 \u0438\u043b\u0438 \u0437\u0430\u0434\u0430\u043d\u0438\u044f"
                },
                "scripture_ref": {
                  "type": "string",
                  "description": "\u041e\u0442\u0440\u044b\u0432\u043e\u043a \u041f\u0438\u0441\u0430\u043d\u0438\u044f \u0434\u043b\u044f \u0432\u043e\u043f\u0440\u043e\u0441\u0430 (\u0435\u0441\u043b\u0438 \u0435\u0441\u0442\u044c)"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "reflection",
                    "practice"
                  ],
                  "default": "text",
                  "description": "\u0422\u0438\u043f \u0437\u0430\u0434\u0430\u043d\u0438\u044f: \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u044b\u0439 \u043e\u0442\u0432\u0435\u0442, \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u0435 \u0438\u043b\u0438 \u043f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435"
                }
              }
            }
          },
          "practice_prompt": {
            "type": "string",
            "description": "\u041f\u0440\u0430\u043a\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u043e\u0432\u043e\u0435 \u0443\u043f\u0440\u0430\u0436\u043d\u0435\u043d\u0438\u0435 \u0434\u043d\u044f"
          }
        }
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "course_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    }
  },
  "required": [
    "course_id",
    "module_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.course_status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}