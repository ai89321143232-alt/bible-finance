{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0447\u0451\u0442\u0430"
    },
    "type": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "bank_account",
        "savings",
        "credit"
      ],
      "description": "\u0422\u0438\u043f \u0441\u0447\u0451\u0442\u0430"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "\u0422\u0435\u043a\u0443\u0449\u0438\u0439 \u0431\u0430\u043b\u0430\u043d\u0441"
    },
    "currency": {
      "type": "string",
      "default": "RUB",
      "description": "\u0412\u0430\u043b\u044e\u0442\u0430 \u0441\u0447\u0451\u0442\u0430"
    },
    "color": {
      "type": "string",
      "description": "\u0426\u0432\u0435\u0442 \u0434\u043b\u044f \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"
    },
    "icon": {
      "type": "string",
      "description": "\u0418\u043a\u043e\u043d\u043a\u0430 \u0441\u0447\u0451\u0442\u0430"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "credit_limit": {
      "type": "number",
      "description": "\u041a\u0440\u0435\u0434\u0438\u0442\u043d\u044b\u0439 \u043b\u0438\u043c\u0438\u0442 (\u0434\u043b\u044f \u043a\u0440\u0435\u0434\u0438\u0442\u043d\u044b\u0445 \u043a\u0430\u0440\u0442)"
    },
    "family_id": {
      "type": "string",
      "description": "ID \u0441\u0435\u043c\u044c\u0438"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f-\u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0441\u0447\u0451\u0442\u0430"
    }
  },
  "required": [
    "name",
    "type",
    "currency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.family_id": "{{user.family_id}}"
            },
            {
              "user.family_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "user.family_id": null
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.family_id": "{{user.family_id}}"
            },
            {
              "user.family_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "user.family_id": null
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.family_id": "{{user.family_id}}"
            },
            {
              "user.family_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "user.family_id": null
            }
          ]
        }
      ]
    }
  }
}