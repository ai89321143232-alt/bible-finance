{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0441\u0447\u0451\u0442\u0430"
    },
    "type": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "bank_account",
        "savings",
        "credit"
      ],
      "description": "\u0422\u0438\u043f \u0441\u0447\u0451\u0442\u0430"
    },
    "balance": {
      "type": "number",
      "default": 0,
      "description": "\u0422\u0435\u043a\u0443\u0449\u0438\u0439 \u0431\u0430\u043b\u0430\u043d\u0441 (\u043f\u043e\u043b\u043d\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u043d\u0430 \u0441\u0447\u0451\u0442\u0435, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0437\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u044b\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430)"
    },
    "frozen_amount": {
      "type": "number",
      "default": 0,
      "description": "\u0417\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u0441\u0443\u043c\u043c\u0430 \u2014 \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u0430 \u043f\u043e\u0434 \u0446\u0435\u043b\u0438, \u043d\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0434\u043b\u044f \u043e\u0431\u044b\u0447\u043d\u044b\u0445 \u0442\u0440\u0430\u0442"
    },
    "currency": {
      "type": "string",
      "default": "RUB",
      "description": "\u0412\u0430\u043b\u044e\u0442\u0430 \u0441\u0447\u0451\u0442\u0430"
    },
    "exchange_rate": {
      "type": "number",
      "description": "\u041a\u0443\u0440\u0441 \u0432\u0430\u043b\u044e\u0442\u044b \u0441\u0447\u0451\u0442\u0430 \u043a \u0432\u0430\u043b\u044e\u0442\u0435 \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u043d\u0430 \u043c\u043e\u043c\u0435\u043d\u0442 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f (\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0435\u0434\u0438\u043d\u0438\u0446 \u0432\u0430\u043b\u044e\u0442\u044b \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u0437\u0430 1 \u0435\u0434\u0438\u043d\u0438\u0446\u0443 \u0432\u0430\u043b\u044e\u0442\u044b \u0441\u0447\u0451\u0442\u0430)"
    },
    "color": {
      "type": "string",
      "description": "\u0426\u0432\u0435\u0442 \u0434\u043b\u044f \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f"
    },
    "icon": {
      "type": "string",
      "description": "\u0418\u043a\u043e\u043d\u043a\u0430 \u0441\u0447\u0451\u0442\u0430"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "credit_limit": {
      "type": "number",
      "description": "\u041a\u0440\u0435\u0434\u0438\u0442\u043d\u044b\u0439 \u043b\u0438\u043c\u0438\u0442 (\u0434\u043b\u044f \u043a\u0440\u0435\u0434\u0438\u0442\u043d\u044b\u0445 \u043a\u0430\u0440\u0442)"
    },
    "family_id": {
      "type": "string",
      "description": "ID \u0441\u0435\u043c\u044c\u0438"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f-\u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0441\u0447\u0451\u0442\u0430"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (Workspace-\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "\u0412\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u044c: \u043b\u0438\u0447\u043d\u0430\u044f \u0438\u043b\u0438 \u043e\u0431\u0449\u0430\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430"
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "business"
      ],
      "default": "personal",
      "description": "\u041e\u0431\u043b\u0430\u0441\u0442\u044c \u0441\u0447\u0451\u0442\u0430: \u043b\u0438\u0447\u043d\u044b\u0435 \u0444\u0438\u043d\u0430\u043d\u0441\u044b \u0438\u043b\u0438 \u0431\u0438\u0437\u043d\u0435\u0441 (\u0418\u041f/\u0441\u0430\u043c\u043e\u0437\u0430\u043d\u044f\u0442\u043e\u0441\u0442\u044c)"
    }
  },
  "required": [
    "name",
    "type",
    "currency"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": {
                "$ne": null
              }
            },
            {
              "data.family_id": "{{user.data.family_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}