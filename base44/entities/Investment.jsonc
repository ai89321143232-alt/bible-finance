{
  "name": "Investment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u0430"
    },
    "type": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "etf",
        "bonds",
        "deposit",
        "real_estate",
        "precious_metals",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u0430\u043a\u0442\u0438\u0432\u0430"
    },
    "ticker": {
      "type": "string",
      "description": "\u0422\u0438\u043a\u0435\u0440 (\u0434\u043b\u044f \u0430\u043a\u0446\u0438\u0439/\u043a\u0440\u0438\u043f\u0442\u043e)"
    },
    "quantity": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e"
    },
    "purchase_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u0437\u0430 \u0435\u0434\u0438\u043d\u0438\u0446\u0443"
    },
    "current_price": {
      "type": "number",
      "description": "\u0422\u0435\u043a\u0443\u0449\u0430\u044f \u0446\u0435\u043d\u0430 \u0437\u0430 \u0435\u0434\u0438\u043d\u0438\u0446\u0443"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "broker": {
      "type": "string",
      "description": "\u0411\u0440\u043e\u043a\u0435\u0440/\u0431\u0438\u0440\u0436\u0430"
    },
    "notes": {
      "type": "string"
    },
    "interest_rate": {
      "type": "number",
      "description": "\u0413\u043e\u0434\u043e\u0432\u0430\u044f \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u0430\u044f \u0441\u0442\u0430\u0432\u043a\u0430 (\u0434\u043b\u044f \u0432\u043a\u043b\u0430\u0434\u043e\u0432)"
    },
    "maturity_date": {
      "type": "string",
      "format": "date",
      "description": "\u0421\u0440\u043e\u043a \u043e\u043a\u043e\u043d\u0447\u0430\u043d\u0438\u044f \u0432\u043a\u043b\u0430\u0434\u0430 (\u0434\u043b\u044f \u0432\u044b\u0432\u043e\u0434\u0430)"
    },
    "allows_top_up": {
      "type": "boolean",
      "default": false,
      "description": "\u0412\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043f\u043e\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0432\u043a\u043b\u0430\u0434\u0430"
    },
    "linked_goal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "ID \u0446\u0435\u043b\u0435\u0439, \u043d\u0430 \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u0432\u043a\u043b\u0430\u0434/\u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u044f"
    },
    "family_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f-\u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430 \u0438\u043d\u0432\u0435\u0441\u0442\u0438\u0446\u0438\u0438"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 (Workspace-\u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u0430)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "\u0412\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u044c: \u043b\u0438\u0447\u043d\u0430\u044f \u0438\u043b\u0438 \u043e\u0431\u0449\u0430\u044f \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430"
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "quantity",
    "purchase_price"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": "{{user.data.family_id}}"
            },
            {
              "data.family_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": "{{user.data.family_id}}"
            },
            {
              "data.family_id": {
                "$ne": null
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}