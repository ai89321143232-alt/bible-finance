{
  "name": "Investment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u0430\u043a\u0442\u0438\u0432\u0430"
    },
    "type": {
      "type": "string",
      "enum": [
        "stocks",
        "crypto",
        "etf",
        "bonds",
        "deposit",
        "real_estate",
        "precious_metals",
        "other"
      ],
      "description": "\u0422\u0438\u043f \u0430\u043a\u0442\u0438\u0432\u0430"
    },
    "ticker": {
      "type": "string",
      "description": "\u0422\u0438\u043a\u0435\u0440"
    },
    "quantity": {
      "type": "number",
      "description": "\u041a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e"
    },
    "purchase_price": {
      "type": "number",
      "description": "\u0426\u0435\u043d\u0430 \u043f\u043e\u043a\u0443\u043f\u043a\u0438 \u0437\u0430 \u0435\u0434\u0438\u043d\u0438\u0446\u0443"
    },
    "current_price": {
      "type": "number",
      "description": "\u0422\u0435\u043a\u0443\u0449\u0430\u044f \u0446\u0435\u043d\u0430 \u0437\u0430 \u0435\u0434\u0438\u043d\u0438\u0446\u0443"
    },
    "purchase_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "default": "RUB"
    },
    "broker": {
      "type": "string",
      "description": "\u0411\u0440\u043e\u043a\u0435\u0440 \u0438\u043b\u0438 \u0431\u0430\u043d\u043a"
    },
    "notes": {
      "type": "string"
    },
    "interest_rate": {
      "type": "number",
      "description": "\u0413\u043e\u0434\u043e\u0432\u0430\u044f \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u043d\u0430\u044f \u0441\u0442\u0430\u0432\u043a\u0430 \u0434\u043b\u044f \u0432\u043a\u043b\u0430\u0434\u043e\u0432"
    },
    "maturity_date": {
      "type": "string",
      "format": "date"
    },
    "allows_top_up": {
      "type": "boolean",
      "default": false
    },
    "linked_goal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "linked_investment_amounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "goal_id": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "coupon_per_unit": {
      "type": "number",
      "description": "\u0412\u044b\u043f\u043b\u0430\u0442\u0430 \u043d\u0430 \u0435\u0434\u0438\u043d\u0438\u0446\u0443 \u0430\u043a\u0442\u0438\u0432\u0430"
    },
    "dividend_yield": {
      "type": "number",
      "description": "\u041e\u0436\u0438\u0434\u0430\u0435\u043c\u0430\u044f \u0433\u043e\u0434\u043e\u0432\u0430\u044f \u0434\u043e\u0445\u043e\u0434\u043d\u043e\u0441\u0442\u044c \u0432 \u043f\u0440\u043e\u0446\u0435\u043d\u0442\u0430\u0445"
    },
    "payout_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "semiannual",
        "annual"
      ]
    },
    "next_payout_date": {
      "type": "string",
      "format": "date"
    },
    "nominal_value": {
      "type": "number",
      "description": "\u041d\u043e\u043c\u0438\u043d\u0430\u043b \u043e\u0431\u043b\u0438\u0433\u0430\u0446\u0438\u0438"
    },
    "family_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "ID \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0430"
    },
    "workspace_id": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private"
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "business"
      ],
      "default": "personal"
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "quantity",
    "purchase_price"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": "{{user.data.family_id}}"
            },
            {
              "data.family_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.family_id": "{{user.data.family_id}}"
            },
            {
              "data.family_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}